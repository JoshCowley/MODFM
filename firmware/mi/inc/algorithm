#pragma once
/* the part of <algorithm> the Mutable modules use */
namespace std {
template <typename T> inline const T &min(const T &a, const T &b) { return b < a ? b : a; }
template <typename T> inline const T &max(const T &a, const T &b) { return a < b ? b : a; }
template <typename T> inline void swap(T &a, T &b) { T t = a; a = b; b = t; }
template <typename I, typename T> inline void fill(I first, I last, const T &v) { for (; first != last; ++first) *first = v; }
template <typename I, typename O> inline O copy(I first, I last, O out) { for (; first != last; ++first, ++out) *out = *first; return out; }
template <typename I, typename T> inline I lower_bound(I first, I last, const T &v)
{
    long n = last - first;
    while (n > 0) { long h = n / 2; I m = first + h; if (*m < v) { first = m + 1; n -= h + 1; } else n = h; }
    return first;
}
}
